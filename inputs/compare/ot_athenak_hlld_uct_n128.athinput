# Orszag-Tang — matched to spd_K N=32 p=3 (128 fine cells).
# HLLD + UCT-HLLD + MOOD (AthenaK's proven-stable OT configuration).
# Use mood_edge=flag with UCT (blend is unstable on OT ~t=0.27).
<comment>
problem   = Orszag-Tang vortex
scheme    = hlld_uct_mood
compare   = spd_K ot_spdk_n32_fb

<job>
basename   = ot_hlld_uct_n128

<mesh>
nghost    = 5
nx1       = 128
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 128
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 128
nx3       = 1

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.3
nlim       = -1
tlim       = 1.0
ndiag      = 50

<mhd>
eos         = ideal
reconstruct = ppm
rsolver     = hlld
emf         = uct_hlld
mood        = true
fofc        = false
mood_max_revs = 3
mood_nad_b  = mag
mood_nad_v  = off
mood_edge   = flag
mood_rtol   = 1.0e-5
gamma       = 1.666666667

<problem>
pgen_name   = orszag_tang

<output1>
file_type   = hst
dt          = 0.01

<output2>
file_type  = bin
variable   = mhd_w_bcc
dt         = 0.1

<output3>
file_type  = bin
variable   = mhd_fb_level
dt         = 0.1

<output4>
file_type  = log
dcycle     = 50
