# Orszag-Tang with HLLD, MOOD locked at the MUSCL cascade level (diagnostic).
# This is the configuration that suffered timestep collapse before the low-order
# Riemann solves took their normal field from the CT face array.
<job>
system   = mhd
fallback = true

<mesh>
p    = 3
nx1  = 32
nx2  = 32
nx3  = 1
x1len = 1.0
x2len = 1.0
x3len = 1.0

<time>
tlim       = 1.0
cfl        = 0.4
integrator = rk3

<hydro>
gamma = 1.6666666666667

<mhd>
rsolver          = hlld
mood_force_level = 1

<problem>
problem = orszag_tang

<output>
dt = 0.25
