# Magnetized Kelvin-Helmholtz of Rueda-Ramirez, Hindenlang, Chan & Gassner 2022
# (arXiv:2203.06062) section 5.2, "Entropy-Stable Gauss Collocation Methods for
# Ideal MHD". They take the setup from Mignone et al., so it is the same family
# as the MDZ21 section 6.5 test but far better posed for this code:
#
#   * the perturbation is a SINGLE DETERMINISTIC MODE,
#       v2 = 0.01 sin(2 pi x) exp(-y^2 / 0.1^2)
#     so there is no random seed to reproduce -- unlike MDZ21 6.5, whose
#     per-zone uniform noise cannot survive a cell-integrated initialisation;
#   * the shear width y0 = 1/20 is FIVE TIMES MDZ21's, so it is actually
#     resolved (~6 cells at 128x256 DoF rather than ~1.3);
#   * the reference runs polynomial degree N = 3 and N = 7, which are exactly
#     this code's SDFB4 and SDFB8 lanes -- a direct high-order comparison.
#
# rho = 1, p = 1/gamma (so c_s = 1), M = 1, ca = 0.1, theta = pi/3.
# B = (ca cos theta, 0, ca sin theta): the TOROIDAL B3 is nonzero, so the
# Lorentz force acts on the z-momentum and the run is genuinely pseudo-2D --
# in spd_K's true 2D that row is a cell-centred conserved variable.
#
# Paper domain x in [0,1], y in [-1,1]; spd_K is origin-anchored so this is
# [0,1] x [0,2] with the shear layer at y = 1. Periodic in x, perfectly
# conducting slip walls top and bottom.
#
# Resolutions 64x128, 128x256, 256x512 DoF; times t = 5, 8, 12, 20.
# Diagnostics (their eqs. 100/101, both from Mignone et al.):
#   <B_p^2>(t)  poloidal magnetic energy, normalised to t=0
#   dv_y(t)     growth rate, (max v_y - min v_y)/2
# 128x256 DoF is p=3 with nx1=32, nx2=64 (or p=7 with 16x32).

<job>
system   = mhd
fallback = true

<mesh>
p     = 3
nx1   = 32
nx2   = 64
nx3   = 1
x1len = 1.0
x2len = 2.0
x1_bc = periodic
x2_bc = reflective

<time>
tlim       = 20.0
cfl        = 0.4          # p=3 under cfl_type=sum; SDFB8 (p=7) uses 0.30
integrator = rk3
cfl_type   = sum

<hydro>
gamma = 1.6666666666667

<mhd>
rsolver = hlld
emf     = uct

<problem>
problem = kh_rr22
amp     = 0.1                  # ca, the Alfven speed
v1      = 1.0                  # M, the sonic Mach number
v2      = 0.01                 # v2_0, the single-mode perturbation amplitude
p1      = 1.0471975511965976   # theta = pi/3, the field angle in the xz plane
sigma   = 0.05                 # y0 = 1/20, the shear steepness
radius  = 0.1                  # sigma, the perturbation width in y
d0      = 1.0                  # rho
p0      = 0.6                  # p = 1/gamma for gamma = 5/3

<output>
dt = 0.5

<fallback>
max_revs = 3
