# Wu & Shu (2018) strong MHD blast — Balsara et al. 2025 §8.1 / Fig. 10.
# Domain [-0.6,0.6]^2 (x1len=1.2), outflow (gradfree) boundaries.
<job>
system   = mhd
fallback = true

<mesh>
p    = 3
nx1  = 50
nx2  = 50
nx3  = 1
x1len = 1.2
x2len = 1.2
x1_bc = gradfree
x2_bc = gradfree

<time>
tlim       = 0.001
cfl        = 0.2
integrator = rk3

<hydro>
gamma = 1.6666666666667

<mhd>
rsolver = hlld

<fallback>
max_revs = 3
tolerance = 1e-5
NAD = relative
NAD_neighbors = 2nd
SED = true

<problem>
problem = mhd_blast
amp = 1000.0
d0 = 1.0
p0 = 0.1
p1 = 10000.0
radius = 0.1

<output>
dt = 0.001
